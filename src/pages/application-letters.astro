---
import BaseLayout from "@layouts/BaseLayout.astro";
import Button from "@components/Button.astro";
import PageHeader from "@components/PageHeader.astro";
import { getCollection } from "astro:content";
import { ui } from "@lib/i18n";

const letters = (await getCollection("applicationLetters")).sort((a, b) =>
    b.data.slug.localeCompare(a.data.slug),
);

const humanize = (slug: string) =>
    slug
        .split("-")
        .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
        .join(" ");

const prefetchUrls = ["/", "/cv", "/projects"];
---

<BaseLayout
    t={ui.en}
    title="Application Letters"
    description="List of application letters written by Hans Askov"
    theme="light"
    prefetchUrls={prefetchUrls}
    includeSidebar={true}
    shouldIndex={false}
>
    <PageHeader
        title="Application Letters"
        description="Letters I have written when applying for positions, kept here as writing samples."
    />


    <ul class="mt-8 divide-y divide-line">
        {
            letters.map((letter) => (
                <li class="flex items-center justify-between gap-4 py-3.5">
                    <a
                        href={`/application-letter/${letter.data.slug}`}
                        class="link link-hover t-body-sm font-medium"
                    >
                        {humanize(letter.data.slug)}
                    </a>
                    <Button
                        variant="secondary"
                        size="sm"
                        href={`/application-letter-${letter.data.slug}.pdf`}
                        download
                    >
                        Download
                    </Button>
                </li>
            ))
        }
    </ul>

    <div class="mt-6 flex justify-end">
        <Button href="/cvs" variant="secondary">View CVs</Button>
    </div>
</BaseLayout>
