---
import BaseLayout from "@layouts/BaseLayout.astro";
import HorizontalCard from "@components/HorizontalCard.astro";
import PageHeader from "@components/PageHeader.astro";
import { getCollection } from "astro:content";
import { ui } from "@lib/i18n";

const projects = (await getCollection("projects")).sort(
    (a, b) => a.data.order - b.data.order,
);
const prefetchUrls = ["/", "/cv"];
const includeSidebar = true;
---

<BaseLayout
    t={ui.en}
    title="Projects"
    description="List of all projects Hans Askov has worked on"
    theme="light"
    {prefetchUrls}
    {includeSidebar}
>
    <PageHeader
        title="Projects"
        description="Things I have designed, built and shipped."
    />

    <div class="mt-8 space-y-4">
        {projects.map((project) => <HorizontalCard {...project.data} />)}
    </div>
</BaseLayout>
