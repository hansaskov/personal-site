---
import BaseLayout from "@layouts/BaseLayout.astro";
import Button from "@components/Button.astro";
import PageHeader from "@components/PageHeader.astro";
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import {
  getLocalized,
  localeStaticPaths,
  otherLocale,
  type Locale,
} from "@lib/i18n";

export function getStaticPaths() {
  return localeStaticPaths();
}

const locale = Astro.params.locale as Locale;
const t = await getLocalized("layout", locale);
const page = await getLocalized("applicationLettersPage", locale);
const { title, description, metaDescription, download, viewCvs } = page.data;

const letters = (await getCollection("applicationLetters"))
  .filter((letter) => letter.data.locale === locale)
  .sort((a, b) => b.data.slug.localeCompare(a.data.slug));

const humanize = (slug: string) =>
  slug
    .split("-")
    .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
    .join(" ");

const path = getRelativeLocaleUrl(locale, "application-letters");
const prefetchUrls = [
  getRelativeLocaleUrl(locale),
  getRelativeLocaleUrl(locale, "cv"),
  getRelativeLocaleUrl(locale, "projects"),
];
const other = otherLocale(locale);
---

<BaseLayout
  t={t.data}
  path={path}
  localeToggle={{
    target: other,
    href: getRelativeLocaleUrl(other, "application-letters"),
  }}
  title={title}
  description={metaDescription}
  theme="light"
  {prefetchUrls}
  includeSidebar={true}
  shouldIndex={false}
>
  <PageHeader title={title} description={description} />

  <ul class="mt-8 divide-y divide-line">
    {
      letters.map((letter) => (
        <li class="flex items-center justify-between gap-4 py-3.5">
          <a
            href={getRelativeLocaleUrl(
              locale,
              `application-letter/${letter.data.slug}`,
            )}
            class="link link-hover t-body-sm font-medium"
          >
            {humanize(letter.data.slug)}
          </a>
          <Button
            variant="secondary"
            size="sm"
            href={`/application-letter-${letter.data.slug}.pdf`}
            download
          >
            {download}
          </Button>
        </li>
      ))
    }
  </ul>

  <div class="mt-6 flex justify-end">
    <Button href={getRelativeLocaleUrl(locale, "cvs")} variant="secondary">
      {viewCvs}
    </Button>
  </div>
</BaseLayout>
