---
import BaseLayout from "@layouts/BaseLayout.astro";
import Button from "@components/Button.astro";
import DocumentList from "@components/DocumentList.astro";
import PageHeader from "@components/PageHeader.astro";
import { getLocalized, getLocaleDocs, humanizeSlug, localeStaticPaths, localeToggle, pageUrl, type Locale } from "@lib/i18n";

export const getStaticPaths = localeStaticPaths;

const locale = Astro.params.locale as Locale;
const { data: layout } = await getLocalized("layout", locale);
const { data: page } = await getLocalized("applicationLettersPage", locale);

const path = pageUrl(locale, "application-letters");
const toggle = localeToggle(locale, "application-letters");
const prefetchUrls = [pageUrl(locale), pageUrl(locale, "cv"), pageUrl(locale, "projects")];
const cvsUrl = pageUrl(locale, "cvs");

const letterHref = (slug: string) => pageUrl(locale, `application-letter/${slug}`);
const pdfHref = (slug: string) => `/application-letter-${slug}.pdf`;
const items = (await getLocaleDocs("applicationLetters", locale, "desc")).map((letter) => ({
  title: humanizeSlug(letter.data.slug),
  href: letterHref(letter.data.slug),
  pdfUrl: pdfHref(letter.data.slug),
}));
---

<BaseLayout
  t={layout}
  path={path}
  localeToggle={toggle}
  title={page.title}
  description={page.metaDescription}
  prefetchUrls={prefetchUrls}
  shouldIndex={false}
>
  <PageHeader title={page.title} description={page.description} />
  <DocumentList items={items} downloadLabel={page.download} />
  <div class="mt-6 flex justify-end">
    <Button href={cvsUrl} variant="secondary">{page.viewCvs}</Button>
  </div>
</BaseLayout>
