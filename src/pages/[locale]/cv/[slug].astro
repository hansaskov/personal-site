---
import BaseLayout from "@layouts/BaseLayout.astro";
import PageHeader from "@components/PageHeader.astro"
import TimeLine from "@components/TimeLine.astro";
import { getLocalized, localeToggle, pageUrl } from "@lib/i18n";
import { localeSlugStaticPaths } from "@lib/i18n";

export const getStaticPaths = () => localeSlugStaticPaths("cvs");

const { entry: CV } = Astro.props;
const { locale, slug, title, intro, skills, experiances, educations } = CV.data;
const { data: layout } = await getLocalized("layout", locale);

const path = pageUrl(locale, `cv/${slug}`);
const toggle = localeToggle(locale, "cv");
const prefetchUrls = [pageUrl(locale), pageUrl(locale, "projects")];
const pdfUrl = `/hans-askov-cv-${slug}.pdf`;

const personalInfo = { name: "Hans Askov", email: "hans@askov.dk", phone: "+45 24 96 51 87" };
const download_button = { title: layout.cv.download, url: pdfUrl };
const sections = [
  { heading: layout.cv.experience, items: experiances },
  { heading: layout.cv.education, items: educations },
];
---

<BaseLayout
  t={layout}
  path={path}
  localeToggle={toggle}
  title={`${personalInfo.name} - ${title}`}
  description={intro}
  prefetchUrls={prefetchUrls}
  download_button={download_button}
  personalInfo={personalInfo}
  languages={layout.spokenLanguages}
  skills={skills}
  aboutMe={layout.cv.aboutMe}
  shouldIndex={false}
>
    <PageHeader title={personalInfo.name} description={title} />
    <p class="t-body mt-4 max-w-prose text-fg-muted">{intro}</p>

  {sections.map(({ heading, items }) => (
    <div class="mt-section space-y-2">
        <h2 class="pb-2">{heading}</h2>
      <TimeLine experiances={items} />
    </div>
  ))}
</BaseLayout>
