---
import BaseLayout from "@layouts/BaseLayout.astro";
import HorizontalCard from "@components/HorizontalCard.astro";
import PageHeader from "@components/PageHeader.astro";
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import {
  getLocalized,
  localeStaticPaths,
  otherLocale,
  type Locale,
} from "@lib/i18n";

export function getStaticPaths() {
  return localeStaticPaths();
}

const locale = Astro.params.locale as Locale;
const t = await getLocalized("layout", locale);
const page = await getLocalized("projectsPage", locale);
const { title, description, metaDescription } = page.data;

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);
const path = getRelativeLocaleUrl(locale, "projects");
const prefetchUrls = [
  getRelativeLocaleUrl(locale),
  getRelativeLocaleUrl(locale, "cv"),
];
const other = otherLocale(locale);
---

<BaseLayout
  t={t.data}
  path={path}
  localeToggle={{ target: other, href: getRelativeLocaleUrl(other, "projects") }}
  title={title}
  description={metaDescription}
  theme="light"
  {prefetchUrls}
  includeSidebar={true}
  hreflang={{
    en: getRelativeLocaleUrl("en", "projects"),
    da: getRelativeLocaleUrl("da", "projects"),
  }}
>
  <PageHeader title={title} description={description} />

  <div class="mt-8 space-y-4">
    {projects.map((project) => <HorizontalCard {...project.data} />)}
  </div>
</BaseLayout>
