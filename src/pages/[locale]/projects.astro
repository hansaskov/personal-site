---
import BaseLayout from "@layouts/BaseLayout.astro";
import ProjectCard from "@components/ProjectCard.astro";
import PageHeader from "@components/PageHeader.astro";
import { getLocalized, getSortedProjects, hreflangUrls, localeStaticPaths, localeToggle, pageUrl, type Locale } from "@lib/i18n";

export const getStaticPaths = localeStaticPaths;

const locale = Astro.params.locale as Locale;
const { data: layout } = await getLocalized("layout", locale);
const { data: page } = await getLocalized("projectsPage", locale);

const path = pageUrl(locale, "projects");
const toggle = localeToggle(locale, "projects");
const hreflang = hreflangUrls("projects");
const prefetchUrls = [pageUrl(locale), pageUrl(locale, "cv")];

const [featured, ...rest] = await getSortedProjects();
---

<BaseLayout
  t={layout}
  path={path}
  localeToggle={toggle}
  title={page.title}
  description={page.metaDescription}
  prefetchUrls={prefetchUrls}
  hreflang={hreflang}
  wide
>
  <PageHeader title={page.title} description={page.description} />

  <div class="@container mt-8 space-y-5">
    {featured && <ProjectCard project={featured.data} featured />}
    <div class="grid gap-5 @xl:grid-cols-2">
      {rest.map((project) => <ProjectCard project={project.data} />)}
    </div>
  </div>
</BaseLayout>
