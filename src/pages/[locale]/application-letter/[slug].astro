---
import BaseLayout from "@layouts/BaseLayout.astro";
import { getLocalized, localeToggle, pageUrl } from "@lib/i18n";
import { localeSlugStaticPaths } from "@lib/i18n";
import { render } from "astro:content";

export const getStaticPaths = () => localeSlugStaticPaths("applicationLetters");

const { entry: letter } = Astro.props;
const { locale, slug } = letter.data;
const { Content } = await render(letter);
const { data: layout } = await getLocalized("layout", locale);

const path = pageUrl(locale, `application-letter/${slug}`);
const toggle = localeToggle(locale, "application-letters");
const title = slug;
const description = `Application letter for ${slug}`;
---

<BaseLayout
  t={layout}
  path={path}
  localeToggle={toggle}
  title={title}
  description={description}
  includeSidebar={false}
  includeHeader={false}
  includeFooter={false}
  shouldIndex={false}
>
  <article class="application-letter pt-16">
    <Content />
  </article>
</BaseLayout>

<style is:global>
  .application-letter { font-size: var(--pr-fs-600); line-height: 1.75; color: var(--ds-color-fg-default); }
  .application-letter h1, .application-letter h2, .application-letter h3 { font-weight: 600; margin-bottom: 0.5rem; }
  .application-letter p { margin-bottom: 1rem; }
  .application-letter ul, .application-letter ol { margin-bottom: 1rem; padding-left: 1.5rem; }
  .application-letter ul { list-style: disc; }
  .application-letter ol { list-style: decimal; }
</style>
