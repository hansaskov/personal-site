---
import { getCollection } from "astro:content";
import { defaultCvSlug, localeStaticPaths, type Locale } from "@lib/i18n";

export function getStaticPaths() {
  return localeStaticPaths();
}

const locale = Astro.params.locale as Locale;
const slug = defaultCvSlug[locale];
const exists = (await getCollection("cvs")).some(
  (cv) => cv.data.locale === locale && cv.data.slug === slug,
);
if (!exists) {
  throw new Error(`Default CV slug '${slug}' for locale '${locale}' not found in the 'cvs' collection`);
}
return Astro.rewrite(`/${locale}/cv/${slug}`);
---
