---
import BaseLayout from "@layouts/BaseLayout.astro";
import Button from "@components/Button.astro";
import DocumentList from "@components/DocumentList.astro";
import PageHeader from "@components/PageHeader.astro";
import { getLocalized, getLocaleDocs, localeStaticPaths, localeToggle, pageUrl, type Locale } from "@lib/i18n";

export const getStaticPaths = localeStaticPaths;

const locale = Astro.params.locale as Locale;
const { data: layout } = await getLocalized("layout", locale);
const { data: page } = await getLocalized("cvsPage", locale);

const path = pageUrl(locale, "cvs");
const toggle = localeToggle(locale, "cvs");
const prefetchUrls = [pageUrl(locale), pageUrl(locale, "cv"), pageUrl(locale, "projects")];
const lettersUrl = pageUrl(locale, "application-letters");

const cvHref = (slug: string) => pageUrl(locale, `cv/${slug}`);
const pdfHref = (slug: string) => `/hans-askov-cv-${slug}.pdf`;
const items = (await getLocaleDocs("cvs", locale)).map((cv) => ({
  title: cv.data.slug,
  href: cvHref(cv.data.slug),
  pdfUrl: pdfHref(cv.data.slug),
}));
---

<BaseLayout
  t={layout}
  path={path}
  localeToggle={toggle}
  title={page.title}
  description={page.metaDescription}
  prefetchUrls={prefetchUrls}
  shouldIndex={false}
>
  <PageHeader title={page.title} description={page.description} />
  <DocumentList items={items} downloadLabel={page.download} />
  <div class="mt-6 flex justify-end">
    <Button href={lettersUrl} variant="secondary">{page.viewLetters}</Button>
  </div>
</BaseLayout>
