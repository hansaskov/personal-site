---
import BaseLayout from "@layouts/BaseLayout.astro";
import Button from "@components/Button.astro";
import PageHeader from "@components/PageHeader.astro";
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import {
  getLocalized,
  localeStaticPaths,
  otherLocale,
  type Locale,
} from "@lib/i18n";

export function getStaticPaths() {
  return localeStaticPaths();
}

const locale = Astro.params.locale as Locale;
const t = await getLocalized("layout", locale);
const page = await getLocalized("cvsPage", locale);
const { title, description, metaDescription, download, viewLetters } = page.data;

const cvs = (await getCollection("cvs"))
  .filter((cv) => cv.data.locale === locale)
  .sort((a, b) => a.data.slug.localeCompare(b.data.slug));

const path = getRelativeLocaleUrl(locale, "cvs");
const prefetchUrls = [
  getRelativeLocaleUrl(locale),
  getRelativeLocaleUrl(locale, "cv"),
  getRelativeLocaleUrl(locale, "projects"),
];
const other = otherLocale(locale);
---

<BaseLayout
  t={t.data}
  path={path}
  localeToggle={{ target: other, href: getRelativeLocaleUrl(other, "cvs") }}
  title={title}
  description={metaDescription}
  theme="light"
  {prefetchUrls}
  includeSidebar={true}
  shouldIndex={false}
>
  <PageHeader title={title} description={description} />

  <ul class="mt-8 divide-y divide-line">
    {
      cvs.map((cv) => (
        <li class="flex items-center justify-between gap-4 py-3.5">
          <a
            href={getRelativeLocaleUrl(locale, `cv/${cv.data.slug}`)}
            class="link link-hover t-body-sm font-medium"
          >
            {cv.data.slug}
          </a>
          <Button
            variant="secondary"
            size="sm"
            href={`/hans-askov-cv-${cv.data.slug}.pdf`}
            download
          >
            {download}
          </Button>
        </li>
      ))
    }
  </ul>

  <div class="mt-6 flex justify-end">
    <Button
      href={getRelativeLocaleUrl(locale, "application-letters")}
      variant="secondary"
    >
      {viewLetters}
    </Button>
  </div>
</BaseLayout>
