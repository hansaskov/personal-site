---
import { getCollection } from "astro:content";

export async function getStaticPaths() {
    const cvs = await getCollection("cvs", ({ data }) => data.locale === "en");

    return cvs.map((cv) => ({
        params: { slug: cv.data.slug },
    }));
}

return Astro.rewrite(`/en/cv/${Astro.params.slug}`);
---
