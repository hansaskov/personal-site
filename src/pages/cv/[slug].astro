---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TimeLine from "../../components/TimeLine.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
    const cvs = await getCollection("cvs");

    return cvs.map((cv) => ({
        params: { slug: cv.data.slug },
        props: { CV: cv },
    }));
}

const { CV } = Astro.props;
const { title, intro, skills, experiances, educations } = CV.data;
---

<BaseLayout
    class="space-y-8"
    title={title}
    description={`Hans Askov's ${title} CV`}
    theme="light"
    prefetchUrls={["/", "/projects"]}
    includeSidebar={true}
    download_button={{
        title: "Download CV",
        url: `/hans-askov-cv-${CV.data.slug}.pdf`,
    }}
    personalInfo={{
        name: "Hans Askov",
        email: "hans@askov.dk",
        phone: "+45 24 96 51 87",
        location: "Odense C, 5000, Denmark",
    }}
    languages={[
        {
            name: "Danish",
            rating: 4,
        },
        {
            name: "English",
            rating: 4,
        },
    ]}
    skills={skills}
    aboutMe="My hobbies includes tinkering with homeservers and jogging along Odense River."
>
    <div class="space-y-4">
        <h1 class="text-2xl lg:text-5xl font-semibold text-base-content/85">
            {title}
        </h1>
        <p>{intro}</p>
    </div>

    <div class="space-y-4">
        <h2 class="text-lg lg:text-2xl font-semibold">Experience</h2>
        <TimeLine experiances={experiances} />
    </div>

    <div class="space-y-4">
        <h2 class="text-lg lg:text-2xl font-semibold">Education</h2>
        <TimeLine experiances={educations} />
    </div>
</BaseLayout>
