---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "@components/Button.astro";
import { ui } from "@lib/i18n";
const prefetchUrls = ["/"];
const includeSidebar = false;
---

<BaseLayout
  t={ui.en}
  title="404: Not Found"
  description="Oops, something went wrong"
  theme="light"
  {includeSidebar}
  {prefetchUrls}
>
  <div class="pt-16 text-center">
    <p class="text-8xl" aria-hidden="true">🏝</p>
    <h1 class="mt-6">404</h1>
    <p class="t-lead mx-auto mt-3 max-w-prose text-fg-muted text-balance">
      The page you're looking for couldn't be found. It may have been moved or
      never existed.
    </p>
    <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
      <Button variant="primary" href="/">Back home</Button>
      <Button variant="secondary" href="/projects">Browse projects</Button>
    </div>
    <p class="t-body-sm mt-6 text-fg-muted">
      Or <a class="link" href="mailto:hans@askov.dk">send me an email</a>.
    </p>
  </div>
</BaseLayout>
