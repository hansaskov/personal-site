---
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "@components/Button.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getLocalized } from "@lib/i18n";

const t = await getLocalized("layout", "en");
const page = await getLocalized("notFound", "en");
const { title, description, body, backHome, browseProjects, or, sendEmail } =
  page.data;
const prefetchUrls = [getRelativeLocaleUrl("en")];
const includeSidebar = false;
---

<BaseLayout
  t={t.data}
  localeToggle={{ target: "da", href: getRelativeLocaleUrl("da") }}
  title={title}
  description={description}
  theme="light"
  {includeSidebar}
  {prefetchUrls}
  shouldIndex={false}
>
  <div class="pt-16 text-center">
    <p class="text-8xl" aria-hidden="true">🏝</p>
    <h1 class="mt-6">404</h1>
    <p class="t-lead mx-auto mt-3 max-w-prose text-fg-muted text-balance">
      {body}
    </p>
    <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
      <Button variant="primary" href={getRelativeLocaleUrl("en")}
        >{backHome}</Button
      >
      <Button variant="secondary" href={getRelativeLocaleUrl("en", "projects")}
        >{browseProjects}</Button
      >
    </div>
    <p class="t-body-sm mt-6 text-fg-muted">
      {or}
      <a class="link" href="mailto:hans@askov.dk">{sendEmail}</a>.
    </p>
  </div>
</BaseLayout>
