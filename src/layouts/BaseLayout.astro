---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SideBar from "../components/SideBar.astro";
import type { ComponentProps } from "astro/types";
import SpeculationsAPI from "@components/SpeculationsAPI.astro";

interface Props
  extends
    ComponentProps<typeof BaseHead>,
    ComponentProps<typeof Header>,
    ComponentProps<typeof SideBar>,
    ComponentProps<typeof SpeculationsAPI> {
    theme: "light" | "dark";
    class?: string;
    includeHeader?: boolean;
    includeFooter?: boolean;
  }

const {
  includeHeader = true,
  includeFooter = true,
} = Astro.props;
const props = Astro.props;
---

<!doctype html>
<html lang="en" data-theme={props.theme ?? "light"}>
  <head>
    <BaseHead {...props} />
    <slot name="head" />
  </head>
  <body>
    <div class:list={["flex min-h-dvh", { "lg:flex-row": props.includeSidebar }]}>
      {props.includeSidebar && (
        <>
          <input
            id="site-nav"
            type="checkbox"
            class="sr-only"
            aria-label="Toggle navigation menu"
          />
          <SideBar {...props} />
          <label for="site-nav" class="nav-scrim" aria-hidden="true"></label>
        </>
      )}

      <div class="flex min-w-0 flex-1 flex-col">
        {includeHeader && <Header {...props} />}
        <div class="flex justify-center">
          <main
            id="main-content"
            class:list={[
              "w-full max-w-[46rem] px-gutter pt-5 pb-16 lg:pt-7",
              Astro.props.class,
            ]}
          >
            <slot />
          </main>
        </div>
        {includeFooter && <Footer />}
      </div>
    </div>
  </body>
</html>

<SpeculationsAPI {...props} />
