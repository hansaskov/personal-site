---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SideBar from "../components/SideBar.astro";
import type { ComponentProps } from "astro/types";
import SpeculationsAPI from "@components/SpeculationsAPI.astro";

interface Props
  extends
    ComponentProps<typeof BaseHead>,
    ComponentProps<typeof Header>,
    ComponentProps<typeof SideBar>,
    ComponentProps<typeof SpeculationsAPI> {
    theme: "light" | "dark";
    class?: string;
    includeHeader?: boolean;
    includeFooter?: boolean;
  }

const {
  includeHeader = true,
  includeFooter = true,
} = Astro.props;
const props = Astro.props;
---

<!doctype html>
<html lang="en" data-theme={props.theme ?? "light"}>
  <head>
    <BaseHead {...props} />
    <slot name="head" />
  </head>
  <body>
    <div
      class:list={[
        "bg-base-100 font-sans",
        { "drawer lg:drawer-open": props.includeSidebar },
      ]}
    >
      {props.includeSidebar && <input id="my-drawer" type="checkbox" class="drawer-toggle" />}
      <div class:list={["bg-base-100", { "drawer-content": props.includeSidebar }]}>
        {includeHeader && <Header {...props} />}
        <div class="md:flex md:justify-center">
          <main
            class:list={[
              "p-6 px-12 pt-10 lg:max-w-[900px] max-w-[100vw]",
              Astro.props.class,
            ]}
          >
            <slot />
          </main>
        </div>
        {includeFooter && <Footer />}
      </div>
      {props.includeSidebar && <SideBar {...props} />}
    </div>
  </body>
</html>

<SpeculationsAPI {...props} />
