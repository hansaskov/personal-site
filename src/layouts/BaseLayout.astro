---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SideBar from "../components/SideBar.astro";
import BottomDrawer from "../components/BottomDrawer.astro";
import SideBarMenu from "../components/SideBarMenu.astro";
import type { ComponentProps } from "astro/types";
import SpeculationsAPI from "@components/SpeculationsAPI.astro";
import type { Locale } from "@lib/i18n";

interface Props
  extends
    ComponentProps<typeof BaseHead>,
    ComponentProps<typeof SideBar>,
    Omit<ComponentProps<typeof SpeculationsAPI>, "prefetchUrls"> {
    localeToggle: { target: Locale; href: string };
    theme?: "light" | "dark";
    class?: string;
    includeSidebar?: boolean;
    prefetchUrls?: string[];
    includeHeader?: boolean;
    includeFooter?: boolean;
  }

const {
  includeHeader = true,
  includeFooter = true,
} = Astro.props;
const props = Astro.props;
const includeSidebar = props.includeSidebar ?? true;
const theme = props.theme ?? "light";
const prefetchUrls = props.prefetchUrls ?? [];
---

<!doctype html>
<html lang={props.t.locale} data-theme={theme}>
  <head>
    <BaseHead {...props} />
    <slot name="head" />
  </head>
  <body>
    <div class:list={["flex min-h-dvh", { "lg:flex-row": includeSidebar }]}>
      {includeSidebar && (
        <>
          <SideBar {...props} />
          <BottomDrawer t={props.t}>
            <SideBarMenu {...props} />
          </BottomDrawer>
        </>
      )}

      <div class="flex min-w-0 flex-1 flex-col">
        {includeHeader && <Header {...props} includeSidebar={includeSidebar} />}
        <div class="flex justify-center">
          <main
            id="main-content"
            class:list={[
              "w-full max-w-184 px-gutter pt-5 pb-16 lg:pt-7",
              Astro.props.class,
            ]}
          >
            <slot />
          </main>
        </div>
        {includeFooter && <Footer />}
      </div>
    </div>
  </body>
</html>

<SpeculationsAPI {...props} prefetchUrls={prefetchUrls} />
