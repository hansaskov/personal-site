---
const today = new Date();
const email = "hans@askov.dk";
---

<footer
    class="shrink-0 mt-auto border-t border-line px-gutter h-16 flex items-center justify-center"
>
    <div class="t-caption text-fg-muted flex justify-center items-center gap-3">
        <span>Hans Askov</span>

        <span class="text-fg-subtle select-none" aria-hidden="true">•</span>

        <span>{today.getFullYear()}</span>

        <span class="text-fg-subtle select-none" aria-hidden="true">•</span>

        <a href={`mailto:${email}`} class="link link-hover">
            {email}
        </a>
    </div>
</footer>
