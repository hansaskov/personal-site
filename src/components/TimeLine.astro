---
import type { CollectionEntry } from "astro:content";
import TimeLineHeader from './TimeLineHeader.astro';
import TimeLineBody from './TimeLineBody.astro';

type Cv = CollectionEntry<"cvs">["data"];
type Experiance = Cv["experiances"][number];
type Education = Cv["educations"][number];

interface Props {
  experiances: (Experiance | Education)[]
}

const props = Astro.props;
---

<div class="space-y-8">
      {
        props.experiances.map((experiance) => (
          <div class="space-y-2">
            <TimeLineHeader {...experiance} />
            {experiance.roles.map((role) => (
              <div class="flex gap-4 pl-4">
                <div class="hidden md:block">
                  <span class="bg-fg mt-1.5 block size-3 rounded-full" />
                  <span class="bg-fg block h-full w-0.5 translate-x-[5px]" />
                </div>
                <div>
                  <TimeLineBody {...role} />
                </div>
              </div>
            ))}
          </div>
        ))
      }
    </div>