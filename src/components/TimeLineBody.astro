---
import type { CollectionEntry } from "astro:content";

type Cv = CollectionEntry<"cvs">["data"];
type Role = Cv["experiances"][number]["roles"][number];

export type Props = Role;

const { title, year, description, duration, location } = Astro.props;
---

<h4 class="t-body-sm font-semibold text-balance">
  {title} - {location}
</h4>
<span class="t-caption block text-fg-subtle">
  {year} • {duration}
</span>
<div class="t-body-sm mt-1 text-pretty text-fg-muted">{description}</div>
