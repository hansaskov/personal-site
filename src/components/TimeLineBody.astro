---
import MetaLine from "./MetaLine.astro";
import type { CollectionEntry } from "astro:content";

type Cv = CollectionEntry<"cvs">["data"];
type Role = Cv["experiences"][number]["roles"][number];

export type Props = Role;

const { title, year, description, duration, location } = Astro.props;
---

<h4 class="t-body leading-normal font-semibold text-balance">{title} - {location}</h4>
<MetaLine class="mt-0.5 text-fg-subtle" items={[year, duration]} />
<p class="t-body-sm mt-2 text-pretty text-fg-muted">{description}</p>
