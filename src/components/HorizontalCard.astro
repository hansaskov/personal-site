---
import type { CollectionEntry } from "astro:content";
import { getImage } from "astro:assets";

type Props = CollectionEntry<"projects">["data"];

const width = 375
const height = 211

const { title, desc, img, url, badge, target = "_blank", year } = Astro.props;

const hero1x = await getImage({ src: img, format: "webp", width: 208, height: 117 });
const hero2x = await getImage({ src: img, format: "webp", width: width, height: height });
const srcset = `${hero1x.src} 208w, ${hero2x.src} 375w`;
const sizes = "(min-width: 768px) 208px, 100vw";

---

<Fragment slot="head">
  <link
    rel="preload"
    as="image"
    href={hero1x.src}
    imagesrcset={srcset}
    imagesizes={sizes}
    fetchpriority="auto"
  />
</Fragment>

<article class="group rounded-xl border border-line bg-surface shadow-card transition-[box-shadow,border-color,translate] duration-200 ease-out hover:-translate-y-0.5 hover:border-line-strong hover:shadow-lift">
  <a href={url} target={target} rel="noopener noreferrer" class="flex h-full flex-col items-center gap-5 p-5 md:flex-row">
    <img
      class="w-full max-w-52 shrink-0 rounded-lg border border-line"
      src={hero1x.src}
      srcset={srcset}
      sizes={sizes}
      width={width}
      height={height}
      alt={title}
      loading="lazy"
    />

    <div class="min-w-0 grow">
      <div class="flex flex-wrap items-center gap-x-2.5 gap-y-1">
        <h3 class="t-subheading text-fg transition-colors group-hover:text-brand-text">
          {title}
        </h3>
        {badge && <span class="tag">{badge}</span>}
      </div>
      <p class="t-caption mt-0.5 text-fg-subtle">{year}</p>
      <p class="t-body-sm mt-2 min-h-[calc(1.6em_*_4)] text-fg-muted line-clamp-4">{desc}</p>
    </div>
  </a>
</article>
