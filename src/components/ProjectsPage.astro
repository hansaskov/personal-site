---
import BaseLayout from "@layouts/BaseLayout.astro";
import HorizontalCard from "@components/HorizontalCard.astro";
import PageHeader from "@components/PageHeader.astro";
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import type { Locale } from "@lib/i18n";
import { ui } from "@lib/i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale];

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);
const prefetchUrls = [
  getRelativeLocaleUrl(locale),
  getRelativeLocaleUrl(locale, "cv"),
];
---

<BaseLayout
  t={t}
  title={t.pages.projects.title}
  description={t.pages.projects.metaDescription}
  theme="light"
  {prefetchUrls}
  includeSidebar={true}
  hreflang={{
    en: getRelativeLocaleUrl("en", "projects"),
    da: getRelativeLocaleUrl("da", "projects"),
  }}
>
  <PageHeader
    title={t.pages.projects.title}
    description={t.pages.projects.description}
  />

  <div class="mt-8 space-y-4">
    {projects.map((project) => <HorizontalCard {...project.data} />)}
  </div>
</BaseLayout>
