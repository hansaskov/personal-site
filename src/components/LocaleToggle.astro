---
import type { LayoutData } from "@lib/content.config";
import type { Locale } from "@lib/i18n";

interface Props {
  target: Locale;
  href: string;
  t: LayoutData;
}

const { target, href, t } = Astro.props;
const label = t.localeToggle[target];
---

<a
  class="icon-btn t-caption font-semibold tracking-wide"
  href={href}
  hreflang={target}
  rel="alternate"
  title={label}
  aria-label={label}
>
  {target.toUpperCase()}
</a>
