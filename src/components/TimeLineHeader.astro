---
import type { CollectionEntry } from "astro:content";
import { getImage } from "astro:assets";

type Cv = CollectionEntry<"cvs">["data"];
type Experiance = Cv["experiances"][number];
type Education = Cv["educations"][number];

type Props = Experiance | Education;

const { img, company, duration } = Astro.props;

const width = 48;
const height = 48;

const hero = await getImage({
  src: img,
  format: "webp",
  width: width,
  height: height,
});
---

<Fragment slot="head">
  <link rel="preload" as="image" href={hero.src} fetchpriority="auto" />
</Fragment>

<div class="flex items-center gap-4">
  <div class="rounded-full overflow-hidden w-12 h-12 shrink-0">
      <img
        src={hero.src}
        width={width}
        height={height}
        alt={`${company}'s' Logo`}
      />
  </div>

  <div>
    <h3 class="t-body font-semibold">{company}</h3>
    <span class="t-caption text-fg-muted">{duration}</span>
  </div>
</div>
