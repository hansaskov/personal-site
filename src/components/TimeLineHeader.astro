---
import MetaLine from "./MetaLine.astro";
import TimeLineLogo from "./TimeLineLogo.astro";
import type { CollectionEntry } from "astro:content";

type Cv = CollectionEntry<"cvs">["data"];
type Experience = Cv["experiences"][number];
type Education = Cv["educations"][number];

type Props = Experience | Education;

const { img, company, year, duration } = Astro.props;
---

<header class="flex items-center gap-(--tl-gap)">
  <TimeLineLogo img={img} company={company} />
  <div class="min-w-0">
    <h3 class="tl-heading">{company}</h3>
    <MetaLine class="mt-0.5 text-fg-muted" items={[year, duration]} />
  </div>
</header>
