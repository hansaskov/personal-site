---
import type { ComponentProps } from "astro/types";
import ThemeSelector from "./ThemeSelector.astro";
import LocaleToggle from "./LocaleToggle.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import type { LayoutData } from "@lib/content.config";
import type { Locale } from "@lib/i18n";

interface Props extends ComponentProps<typeof ThemeSelector> {
  includeSidebar: boolean;
  t: LayoutData;
  localeToggle: { target: Locale; href: string };
}

const { includeSidebar, t, localeToggle, ...props } = Astro.props;
const homeUrl = getRelativeLocaleUrl(t.locale);
---

<header
  class="sticky top-0 z-30 h-16 w-full border-b border-line bg-page/90 backdrop-blur-sm lg:border-b-0 lg:bg-transparent lg:backdrop-blur-none"
>
  <div class="flex h-full items-center gap-2 pl-gutter pr-2.5">
    {
      includeSidebar && (
        <label for="bottom-drawer" class="icon-btn lg:hidden" title={t.nav.menu}>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            class="size-6 stroke-current"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.75"
              d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </label>
      )
    }

    <div class="flex flex-1 justify-center lg:hidden">
      <a href={homeUrl} class="text-fg font-semibold tracking-tight">Hans Askov</a>
    </div>

    <div class="ml-auto flex items-center justify-end">
      <LocaleToggle {...localeToggle} t={t} />
      <ThemeSelector {...props} />
    </div>
  </div>
</header>
