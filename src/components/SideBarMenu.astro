---
import type { LayoutData } from "@lib/content.config";
import { getRelativeLocaleUrl } from "astro:i18n";

interface Props {
    t: LayoutData
    path?: string
    pages?: {
        url: string,
        name: string
    }[]
    personalInfo?: {
        name: string
        email: string
        phone: string
    }
    languages?: {
        name: string,
        rating: number
    }[]
    skills?: string[]
    aboutMe?: string
}

const {
    t,
    path,
    pages = [
        {
            url: getRelativeLocaleUrl(t.locale),
            name: t.nav.home,
        },
        {
            url: getRelativeLocaleUrl(t.locale, "projects"),
            name: t.nav.projects,
        },
        {
            url: getRelativeLocaleUrl(t.locale, "cv"),
            name: t.nav.cv,
        }
    ],
    personalInfo,
    languages,
    skills,
    aboutMe
} = Astro.props

const normalize = (path: string) => path.replace(/\/+$/, "") || "/";
const pathname = normalize(path ?? Astro.url.pathname);
const homeUrl = normalize(getRelativeLocaleUrl(t.locale));
const hasInfo = Boolean(personalInfo || languages || skills || aboutMe);

---

<nav>
    <ul class="flex flex-col gap-1" aria-label={t.nav.main}>
        {
            pages.map(({ name, url: rawUrl }) => {
                const url = normalize(rawUrl);
                const active =
                    url === homeUrl
                        ? pathname === url
                        : pathname === url || pathname.startsWith(`${url}/`);
                return (
                    <li>
                        <a
                            class:list={[
                                "t-body-sm flex h-11 items-center rounded-lg px-4 font-medium leading-5 transition-colors hover:bg-active lg:h-10",
                                active && "bg-brand-subtle font-semibold text-brand-text",
                            ]}
                            aria-current={active ? "page" : undefined}
                            href={url}
                        >
                            {name}
                        </a>
                    </li>
                );
            })
        }
    </ul>

    {hasInfo && (
    <div class="mt-8 space-y-8 border-t border-line px-4 pt-8">
        {personalInfo && (
            <div>
                <h2 class="t-overline leading-4">{t.sections.contact}</h2>
                <ul class="t-body-sm mt-3 space-y-2 leading-5 text-fg-muted">
                <li class="flex items-center gap-2">
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        fill="none"
                        width="14"
                        height="14"
                        viewBox="0 0 24 24"
                        stroke-width="2"
                        stroke="currentColor"
                        aria-hidden="true"
                        class="shrink-0"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z"></path>
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z"
                        ></path>
                    </svg>
                    {personalInfo.name}
                </li>
                <li>
                    <a
                        href={`mailto:${personalInfo.email}`}
                        title={personalInfo.email}
                        class="flex w-fit max-w-full items-center gap-2 transition-colors hover:text-fg"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="14"
                            height="14"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            aria-hidden="true"
                            class="shrink-0"
                        >
                            <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"
                            ></path>
                        </svg>
                        {personalInfo.email}
                    </a>
                </li>
                <li class="flex items-center gap-2">
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            width="14"
                            height="14"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            aria-hidden="true"
                            class="shrink-0"
                        >
                            <path
                                d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
                            ></path>
                        </svg>
                        {personalInfo.phone}
                </li>
                </ul>
            </div>
        )}

        {languages && (
            <div>
                <h2 class="t-overline leading-4">{t.sections.languages}</h2>
                <ul class="mt-3 space-y-2">
                {languages.map((language) => (
                    <li class="t-body-sm flex items-center justify-between gap-4 leading-5 text-fg-muted">
                        <span>{language.name}</span>
                        <div
                            class="flex items-center gap-1.5"
                            role="img"
                            aria-label={`${language.name}: ${language.rating} ${t.cv.ratingOutOf}`}
                        >
                            {[1, 2, 3, 4].map((star) => (
                                <span
                                    class:list={[
                                        "rounded-full",
                                        star <= language.rating ? "size-2.5 bg-fg" : "size-2.5 bg-line-strong",
                                    ]}
                                />
                            ))}
                        </div>
                    </li>
                ))}
                </ul>
            </div>
        )}

        {skills && (
            <div>
                <h2 class="t-overline leading-4">{t.sections.skills}</h2>
                <div class="mt-3 flex flex-wrap gap-2">
                    {
                        skills.map((skill) => (
                            <span class="tag">{skill}</span>
                        ))
                    }
                </div>
            </div>
        )}

        {aboutMe && (
            <div>
                <h2 class="t-overline leading-4">{t.sections.aboutMe}</h2>
                <p class="t-body-sm mt-3 text-pretty text-fg-muted">
                    {aboutMe}
                </p>
            </div>
        )}
    </div>
    )}
</nav>
