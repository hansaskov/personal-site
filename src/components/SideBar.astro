---
import SideBarFooter from "./SideBarFooter.astro";
import SideBarHeader from "./SideBarHeader.astro";
import SideBarMenu from "./SideBarMenu.astro";

import type { ComponentProps } from "astro/types";

interface Props
    extends
        ComponentProps<typeof SideBarFooter>,
        ComponentProps<typeof SideBarMenu>,
        ComponentProps<typeof SideBarHeader> {}

const props = Astro.props;
---

<aside class="nav-panel flex flex-col">
    <div
        class="scrollbar-thin scrollbar-gutter-stable scrollbar-thumb-line-strong scrollbar-track-transparent flex-1 overflow-y-auto px-6 pt-10 pb-16 lg:px-7"
    >
        <SideBarHeader {...props} />
        <SideBarMenu {...props} />
    </div>
    <SideBarFooter {...props} />
</aside>
